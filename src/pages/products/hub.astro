---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Section from '../../components/Section.astro';
import CapabilityList from '../../components/CapabilityList.astro';
import LedgerArt from '../../components/LedgerArt.astro';
import LinkCard from '../../components/LinkCard.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import NetworkLogo from '../../components/NetworkLogo.astro';
import MarqueeCta from '../../components/MarqueeCta.astro';
import { NETWORKS, type LinkId, type NetworkId } from '../../config/links';

const capabilities = [
  { title: 'Exactly-once payouts', body: 'A retry never pays twice.' },
  { title: 'One set of books', body: 'Matches the chain, line by line.' },
  { title: 'One reference', body: 'From treasury to bank narration.' },
  { title: 'A read-only start', body: 'Watch existing wallets before anything moves.' },
];

const availability: { net: NetworkId; links: LinkId[] }[] = [
  { net: 'tempo', links: ['tempoConsole', 'tempoDocs', 'tempoSource'] },
  { net: 'stellar', links: ['hubStellarSource'] },
];
---

<Base
  title="Corridor Hub"
  description="The payout ledger and router licensed payment companies run on their own keys."
>
  <PageHero
    eyebrow="01 / Product"
    title="Corridor Hub"
    lede="The payout ledger and router licensed payment companies run on their own keys."
  >
    <LedgerArt slot="art" />
  </PageHero>

  <Section num="02" eyebrow="Capabilities" band heading="What the Hub does.">
    <CapabilityList items={capabilities} />
  </Section>

  <Section num="03" eyebrow="Availability" heading="Where the Hub runs.">
    <div class="av">
      {
        availability.map((a, ai) => (
          <div class="av__group" data-reveal data-reveal-delay={ai * 80}>
            <div class="av__head">
              <NetworkLogo network={a.net} size={24} />
              <h3 class="av__net">{NETWORKS[a.net].name}</h3>
              <StatusBadge status={NETWORKS[a.net].status} />
            </div>
            <div class="grid-3">
              {a.links.map((id, i) => <LinkCard id={id} delay={i * 50} />)}
            </div>
          </div>
        ))
      }
    </div>
  </Section>

  <MarqueeCta />
</Base>

<style>
  .av {
    display: grid;
    gap: 44px;
  }

  .av__head {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    padding-bottom: 14px;
    margin-bottom: 22px;
    border-bottom: 1px solid var(--line);
  }

  .av__net {
    font-size: 18px;
  }
</style>
