---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Section from '../../components/Section.astro';
import CapabilityList from '../../components/CapabilityList.astro';
import RampArt from '../../components/RampArt.astro';
import LinkCard from '../../components/LinkCard.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import Button from '../../components/Button.astro';
import WaitlistForm from '../../components/WaitlistForm.astro';
import MarqueeCta from '../../components/MarqueeCta.astro';
import { LINKS } from '../../config/links';

const capabilities = [
  { title: 'Hosted API and TypeScript SDK', body: 'One integration, typed clients.' },
  {
    title: 'Sponsored accounts and trustlines, with your wallet or ours',
    body: 'Bring your own signer. Corridor sponsors the account, the trustline and the fee.',
  },
  { title: 'Payouts and collections', body: 'Out to a bank account, and in from one.' },
  { title: 'Built for agents as well as apps', body: 'The same API serves both.' },
];
---

<Base
  title="Corridor Ramp"
  description="Send and receive local African currency from any app, agent or merchant, through licensed partners."
>
  <PageHero
    eyebrow="01 / Product"
    title="Corridor Ramp"
    lede="Send and receive local African currency from any app, agent or merchant, through licensed partners."
  >
    <Button slot="cta" href={LINKS.rampStellarSource.href} external>View the API and SDK</Button>
    <RampArt slot="art" />
  </PageHero>

  <Section num="02" eyebrow="Capabilities" band heading="What the Ramp does.">
    <CapabilityList items={capabilities} />
  </Section>

  <!-- Pricing: three cells running the full width, no numbers. -->
  <section class="rule-top">
    <div class="cells price" data-reveal>
      <div>
        <span class="num">01</span>
        <p class="price__t">Platform fee</p>
      </div>
      <div>
        <span class="num">02</span>
        <p class="price__t">A small share of volume</p>
      </div>
      <div>
        <span class="num">03</span>
        <p class="price__t">Talk to us for details</p>
      </div>
    </div>
  </section>

  <Section num="03" eyebrow="Availability" heading="Where the Ramp runs.">
    <div class="av" data-reveal>
      <div class="av__head">
        <h3 class="av__net">Ramp on Stellar</h3>
        <StatusBadge status="testnet" />
      </div>
      <div class="grid-3">
        <LinkCard id="rampStellarSource" />
      </div>
    </div>
  </Section>

  <Section num="04" band id="multichain" eyebrow="Roadmap" heading="Ramp multichain.">
    <p slot="lede" class="lede">Join the waitlist for additional settlement networks.</p>
    <div class="mc" data-reveal>
      <div class="mc__badge"><StatusBadge status="coming-soon" /></div>
      <WaitlistForm />
    </div>
  </Section>

  <MarqueeCta />
</Base>

<style>
  .price {
    border-top: 0;
  }

  .price > * {
    display: grid;
    gap: 10px;
    padding-block: 34px;
  }

  .price__t {
    font-size: clamp(18px, 2vw, 26px);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .av__head {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    padding-bottom: 14px;
    margin-bottom: 22px;
    border-bottom: 1px solid var(--line);
  }

  .av__net {
    font-size: 18px;
  }

  .mc {
    display: grid;
    gap: 18px;
    max-width: 880px;
  }
</style>
