---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import NetworkTable from '../components/NetworkTable.astro';
import LanesArt from '../components/LanesArt.astro';
import MarqueeCta from '../components/MarqueeCta.astro';
---

<Base
  title="Networks"
  description="Corridor settles each corridor on the network with the best licensed off-ramps for it. Tempo is live on mainnet; Stellar is on testnet."
>
  <PageHero
    eyebrow="01 / Networks"
    title="Settlement networks and status."
    lede="Each corridor settles on the network with the best licensed off-ramps for it."
  >
    <LanesArt slot="art" />
  </PageHero>

  <Section num="02" eyebrow="Status" band tight>
    <NetworkTable />
  </Section>

  <MarqueeCta />
</Base>
