---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import PrincipleTile from '../components/PrincipleTile.astro';
import CompanyArt from '../components/CompanyArt.astro';
import MarqueeCta from '../components/MarqueeCta.astro';
import { LINKS } from '../config/links';
import { PRINCIPLES } from '../config/content';
---

<Base
  title="Company"
  description="Corridor Finance is building payout infrastructure for Africa's cross-border money movement, from Abuja, Nigeria."
>
  <PageHero
    eyebrow="01 / Company"
    title="About Corridor Finance."
    lede="Building payout infrastructure for Africa's cross-border money movement, from Abuja, Nigeria."
  >
    <CompanyArt slot="art" />
  </PageHero>

  <Section num="02" eyebrow="Founder and contact" band tight>
    <div class="duo">
      <div class="card fo" data-reveal>
        <!--
          PLACEHOLDER: confirm this bio with Udoka before the site goes live.
          Keep it to one line and keep it checkable.
        -->
        <p class="eyebrow">Founder</p>
        <h3 class="fo__name">Udoka A. M.</h3>
        <p class="fo__bio">
          Builds payments infrastructure for African corridors, and shipped the settlement engine
          behind Corridor's first mainnet payout.
        </p>
        <div class="fo__links">
          <a href={LINKS.founderSite.href} target="_blank" rel="noopener noreferrer">
            {LINKS.founderSite.label} ↗
          </a>
          <a href={LINKS.founderGithub.href} target="_blank" rel="noopener noreferrer">
            {LINKS.founderGithub.label} ↗
          </a>
        </div>
      </div>

      <div class="card fo" data-reveal data-reveal-delay="80">
        <p class="eyebrow">Contact</p>
        <h3 class="fo__name">Partnerships, corridors, integrations.</h3>
        <a class="fo__addr" href={LINKS.contact.href}>{LINKS.contact.label} ↗</a>
      </div>
    </div>
  </Section>

  <Section num="03" eyebrow="Principles" heading="How we build.">
    <div class="grid-4">
      {
        PRINCIPLES.map((p, i) => (
          <PrincipleTile title={p.title} body={p.body} icon={p.icon} index={i + 1} delay={i * 60} />
        ))
      }
    </div>
  </Section>

  <MarqueeCta />
</Base>

<style>
  .duo {
    display: grid;
    gap: 20px;
  }

  .fo {
    display: grid;
    align-content: start;
    gap: 14px;
    padding: 30px 26px;
  }

  .fo__name {
    font-size: clamp(18px, 1.8vw, 24px);
  }

  .fo__bio {
    font-size: 13.5px;
    line-height: 24px;
    color: var(--ink-2);
    max-width: 48ch;
  }

  .fo__links {
    display: flex;
    gap: 20px;
    font-size: 12px;
    margin-top: 4px;
  }

  .fo__links a {
    border-bottom: 1px solid var(--y-400);
    padding-bottom: 1px;
  }

  .fo__addr {
    justify-self: start;
    font-size: 13px;
    color: var(--accent-text);
    border-bottom: 1px solid var(--y-400);
    padding-bottom: 1px;
  }

  @media (min-width: 860px) {
    .duo {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
