---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import HeroArt from '../components/HeroArt.astro';
import NetworkStrip from '../components/NetworkStrip.astro';
import RetryArt from '../components/RetryArt.astro';
import Section from '../components/Section.astro';
import ProductCard from '../components/ProductCard.astro';
import NetworkCard from '../components/NetworkCard.astro';
import PrincipleTile from '../components/PrincipleTile.astro';
import MarqueeCta from '../components/MarqueeCta.astro';
import { FIRST_PAYOUT, LINKS } from '../config/links';
import { HERO, LAYERS, PRINCIPLES } from '../config/content';
---

<Base>
  <!-- Hero -->
  <section class="hero">
    <div class="bleed hero__inner">
      <div class="hero__text">
        <p class="eyebrow">01 / Corridor Finance</p>
        <h1 class="hero__h1">{HERO.h1}</h1>
        <p class="hero__sub">{HERO.sub}</p>
        <div class="hero__cta">
          <Button href={LINKS.contact.href} external>Talk to us</Button>
          <Button href="/platform/" variant="ghost">Explore the platform</Button>
        </div>
        <a class="hero__proof" href={FIRST_PAYOUT.href} target="_blank" rel="noopener noreferrer">
          <span class="hero__proof-dot" aria-hidden="true"></span>
          {FIRST_PAYOUT.line}
          <span class="hero__proof-arr" aria-hidden="true">↗</span>
        </a>
      </div>

      <div class="hero__art"><HeroArt /></div>
    </div>
  </section>

  <!-- Networks, flowing -->
  <NetworkStrip />

  <!-- Three layers -->
  <Section num="02" eyebrow="Platform" tag="One platform, three layers" heading="Settlement, and two ways to reach it.">
    <div class="grid-3">
      {
        LAYERS.map((l, i) => (
          <ProductCard
            name={l.name}
            audience={l.audience}
            body={l.body}
            href={l.href}
            icon={l.icon}
            index={i + 1}
            delay={i * 70}
          />
        ))
      }
    </div>
  </Section>

  <!-- Networks -->
  <Section num="03" eyebrow="Settlement" band heading="The network that fits each corridor.">
    <p slot="lede" class="lede">
      Each corridor settles where the licensed off-ramps are strongest. Your integration stays the
      same.
    </p>
    <div class="grid-3">
      <NetworkCard networks={['tempo']} />
      <NetworkCard networks={['stellar']} delay={70} />
      <NetworkCard networks={['base', 'solana']} delay={140} />
    </div>
  </Section>

  <!-- Principles -->
  <Section num="04" eyebrow="Principles" heading="Built for regulated money movement.">
    <div class="grid-4">
      {
        PRINCIPLES.map((p, i) => (
          <PrincipleTile title={p.title} body={p.body} icon={p.icon} index={i + 1} delay={i * 60} />
        ))
      }
    </div>
  </Section>

  <!-- Developers -->
  <section class="section rule-top band-white">
    <div class="bleed devband">
      <div class="devband__text" data-reveal>
        <p class="eyebrow">05 / Developers</p>
        <h2 class="devband__h">One API and SDK for local-currency payouts.</h2>
        <div class="dev">
          <Button href={LINKS.tempoDocs.href} external>Read the docs</Button>
          <Button href={LINKS.rampStellarSource.href} external variant="ghost">View on GitHub</Button>
        </div>
      </div>
      <div class="devband__art" data-reveal data-reveal-delay="90"><RetryArt /></div>
    </div>
  </section>

  <MarqueeCta />
</Base>

<style>
  .hero {
    padding-block: 56px 64px;
  }

  .hero__inner {
    display: grid;
    gap: 44px;
    align-items: center;
  }

  .hero__text {
    display: grid;
    justify-items: start;
    gap: 22px;
  }

  .hero__h1 {
    max-width: 15ch;
  }

  .hero__sub {
    font-size: 15px;
    line-height: 28px;
    color: var(--ink-2);
    max-width: 52ch;
  }

  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .hero__proof {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-size: 11.5px;
    color: var(--ink-muted);
    padding-top: 6px;
    transition: color var(--dur) var(--ease);
  }

  .hero__proof:hover {
    color: var(--ink);
  }

  .hero__proof-dot {
    width: 6px;
    height: 6px;
    background: var(--y-400);
    flex: none;
    animation: blink 2.6s steps(2, end) infinite;
  }

  .hero__proof-arr {
    color: var(--y-600);
  }

  .hero__art {
    max-width: 560px;
    width: 100%;
    justify-self: center;
  }

  .dev {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .devband {
    display: grid;
    gap: 40px;
    align-items: center;
  }

  .devband__text {
    display: grid;
    justify-items: start;
    gap: 22px;
  }

  .devband__h {
    max-width: 14ch;
  }

  .devband__art {
    width: 100%;
    max-width: 640px;
    justify-self: center;
  }

  @media (min-width: 960px) {
    .devband {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      gap: 56px;
    }
    .devband__art {
      justify-self: end;
    }
  }

  @media (min-width: 1000px) {
    .hero {
      padding-block: 76px 88px;
    }
    .hero__inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.95fr);
      gap: 64px;
    }
  }
</style>
