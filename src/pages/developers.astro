---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import SurfaceArt from '../components/SurfaceArt.astro';
import LinkCard from '../components/LinkCard.astro';
import Button from '../components/Button.astro';
import MarqueeCta from '../components/MarqueeCta.astro';
import { LINKS, type LinkId } from '../config/links';

const cards: LinkId[] = [
  'tempoDocs',
  'tempoSource',
  'hubStellarSource',
  'rampStellarSource',
  'rampMultichain',
];
---

<Base
  title="Developers"
  description="Docs, repositories and the hosted payout API and SDK for Corridor Hub and Corridor Ramp."
>
  <PageHero
    eyebrow="01 / Developers"
    title="One API and SDK for local-currency payouts."
    lede="Docs, source and the hosted API. Every badge says where that piece actually runs."
  >
    <Button slot="cta" href={LINKS.tempoDocs.href} external>Read the docs</Button>
    <Button slot="cta" href={LINKS.founderGithub.href} external variant="ghost">View on GitHub</Button>
    <SurfaceArt slot="art" />
  </PageHero>

  <Section num="02" eyebrow="Resources" band tight>
    <div class="grid-3">
      {cards.map((id, i) => <LinkCard id={id} delay={i * 60} />)}
    </div>
  </Section>

  <MarqueeCta />
</Base>
