---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import LayersDiagram from '../components/LayersDiagram.astro';
import PayoutSequence from '../components/PayoutSequence.astro';
import NetworkTable from '../components/NetworkTable.astro';
import ProductCard from '../components/ProductCard.astro';
import MarqueeCta from '../components/MarqueeCta.astro';
import { LAYERS } from '../config/content';
---

<Base
  title="Platform"
  description="One settlement engine and two ways to reach it: Corridor Core, Corridor Hub and Corridor Ramp, settling on the network that fits each corridor."
>
  <PageHero
    eyebrow="01 / Platform"
    title="How the layers fit."
    lede="One settlement engine, two ways to reach it, and the network chosen per corridor."
  >
    <LayersDiagram slot="art" size="lg" />
  </PageHero>

  <Section num="02" eyebrow="Layers" band heading="Three layers, one engine.">
    <div class="grid-3">
      {
        LAYERS.map((l, i) => (
          <ProductCard
            name={l.name}
            audience={l.audience}
            body={l.body}
            href={l.href}
            icon={l.icon}
            index={i + 1}
            delay={i * 70}
          />
        ))
      }
    </div>
  </Section>

  <Section num="03" eyebrow="Sequence" heading="How a payout moves.">
    <PayoutSequence />
  </Section>

  <Section num="04" eyebrow="Networks" band heading="Where it settles.">
    <NetworkTable />
  </Section>

  <MarqueeCta />
</Base>
