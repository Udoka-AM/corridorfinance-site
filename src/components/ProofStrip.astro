---
import { FIRST_PAYOUT } from '../config/links';
---

<aside class="proof" data-reveal>
  <div class="wrap proof__inner">
    <a href={FIRST_PAYOUT.href} target="_blank" rel="noopener noreferrer" class="proof__link">
      <span class="proof__dot" aria-hidden="true"></span>
      <span class="proof__text">{FIRST_PAYOUT.line}</span>
      <svg class="proof__arrow" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
        <path d="M3.5 8.5 8.5 3.5M4.75 3.5h3.75v3.75" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </a>
  </div>
</aside>

<style>
  .proof {
    border-block: 1px solid var(--line);
    background: var(--surface);
  }

  .proof__inner {
    padding-block: 14px;
  }

  .proof__link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 14px;
    line-height: 22px;
    color: var(--ink-muted);
    text-decoration: none;
    transition: color var(--dur) var(--ease);
  }

  .proof__link:hover {
    color: var(--ink);
  }

  .proof__link:hover .proof__arrow {
    transform: translate(2px, -2px);
  }

  .proof__dot {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: var(--accent);
    flex: none;
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 18%, transparent);
  }

  .proof__arrow {
    flex: none;
    color: var(--accent-2);
    transition: transform var(--dur) var(--ease);
  }
</style>
