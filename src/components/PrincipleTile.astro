---
interface Props {
  title: string;
  body: string;
  index: number;
  delay?: number;
}

const { title, body, index, delay = 0 } = Astro.props;
---

<div class="pt" data-reveal data-reveal-delay={delay}>
  <span class="num">{String(index).padStart(2, '0')}</span>
  <h3 class="pt__title">{title}</h3>
  <p class="pt__body">{body}</p>
</div>

<style>
  .pt {
    display: grid;
    align-content: start;
    gap: 8px;
    padding: 30px 26px 34px;
    position: relative;
  }

  /* A yellow tick marks the top-left of each tile. */
  .pt::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 26px;
    height: 2px;
    background: var(--y-300);
  }

  .pt__body {
    font-size: 13.5px;
    line-height: 24px;
    color: var(--ink-2);
  }
</style>
