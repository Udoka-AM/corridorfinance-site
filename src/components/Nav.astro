---
import Wordmark from './Wordmark.astro';
import Button from './Button.astro';
import { LINKS } from '../config/links';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const strip = (p: string) => p.replace(/\/$/, '') || '/';
const isOn = (href: string) => {
  const h = strip(href);
  return path === h || (h !== '/' && path.startsWith(h));
};

const links = [
  { href: '/platform/', label: 'Platform' },
  { href: '/products/hub/', label: 'Hub' },
  { href: '/products/ramp/', label: 'Ramp' },
  { href: '/networks/', label: 'Networks' },
  { href: '/developers/', label: 'Developers' },
  { href: '/company/', label: 'Company' },
];
---

<header class="nav">
  <div class="nav__inner bleed">
    <a href="/" class="nav__brand" aria-label="Corridor Finance, home"><Wordmark /></a>

    <nav class="nav__links" aria-label="Primary">
      {
        links.map((l) => (
          <a href={l.href} class:list={['nav__link', { 'is-on': isOn(l.href) }]}>
            {l.label}
          </a>
        ))
      }
    </nav>

    <div class="nav__right">
      <span class="nav__cta"><Button href={LINKS.contact.href} external>Talk to us</Button></span>
      <button type="button" class="nav__burger" aria-expanded="false" aria-controls="nav-m" aria-label="Menu">
        <span aria-hidden="true"></span><span aria-hidden="true"></span>
      </button>
    </div>
  </div>

  <div class="nav__m" id="nav-m" hidden>
    <div class="bleed nav__m-inner">
      {links.map((l) => <a href={l.href} class="nav__mlink">{l.label}</a>)}
      <span class="nav__mcta"><Button href={LINKS.contact.href} external>Talk to us</Button></span>
    </div>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 60;
    background: color-mix(in srgb, var(--surface) 88%, transparent);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--line);
  }

  .nav__inner {
    display: flex;
    align-items: center;
    gap: 20px;
    height: 62px;
  }

  .nav__brand {
    flex: none;
  }

  .nav__links {
    display: none;
    align-items: center;
    gap: 2px;
    margin-inline: auto;
  }

  .nav__link {
    position: relative;
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-muted);
    padding: 8px 11px;
    transition: color var(--dur) var(--ease);
  }

  .nav__link:hover,
  .nav__link.is-on {
    color: var(--ink);
  }

  /* A yellow underline grows from the left on hover and marks the section. */
  .nav__link::after {
    content: '';
    position: absolute;
    left: 11px;
    right: 11px;
    bottom: 0;
    height: 2px;
    background: var(--y-300);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur) var(--ease-out);
  }

  .nav__link:hover::after,
  .nav__link.is-on::after {
    transform: scaleX(1);
  }

  .nav__right {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-left: auto;
    flex: none;
  }

  .nav__cta {
    display: none;
  }

  .nav__burger {
    display: inline-grid;
    place-content: center;
    gap: 5px;
    width: 34px;
    height: 34px;
    background: transparent;
    border: 1px solid var(--line-strong);
    cursor: pointer;
  }

  .nav__burger span {
    display: block;
    width: 15px;
    height: 1.5px;
    background: var(--ink);
    transition: transform var(--dur) var(--ease);
  }

  .nav__burger[aria-expanded='true'] span:first-child {
    transform: translateY(3.25px) rotate(45deg);
  }

  .nav__burger[aria-expanded='true'] span:last-child {
    transform: translateY(-3.25px) rotate(-45deg);
  }

  .nav__m {
    border-top: 1px solid var(--line);
    background: var(--surface);
  }

  .nav__m[hidden] {
    display: none;
  }

  .nav__m-inner {
    display: grid;
    padding-block: 8px 20px;
  }

  .nav__mlink {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 14px 0;
    border-bottom: 1px solid var(--line);
  }

  .nav__mcta {
    margin-top: 18px;
  }

  .nav__mcta :global(.btn) {
    width: 100%;
    justify-content: center;
  }

  @media (min-width: 1060px) {
    .nav__links { display: flex; }
    .nav__cta { display: inline-flex; }
    .nav__burger, .nav__m { display: none; }
  }
</style>

<script>
  const burger = document.querySelector<HTMLButtonElement>('.nav__burger');
  const panel = document.querySelector<HTMLElement>('.nav__m');

  const set = (open: boolean) => {
    if (!burger || !panel) return;
    burger.setAttribute('aria-expanded', String(open));
    panel.hidden = !open;
  };

  burger?.addEventListener('click', () => set(burger.getAttribute('aria-expanded') !== 'true'));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') set(false);
  });
</script>
