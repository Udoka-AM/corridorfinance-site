<button class="tt" type="button" aria-label="Switch between light and dark theme">
  <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
    <circle class="tt__sun" cx="8" cy="8" r="3.2" stroke="currentColor" stroke-width="1.5" />
    <g class="tt__rays" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
      <path d="M8 1v1.6M8 13.4V15M1 8h1.6M13.4 8H15M3.1 3.1l1.1 1.1M11.8 11.8l1.1 1.1M12.9 3.1l-1.1 1.1M4.2 11.8l-1.1 1.1" />
    </g>
    <path
      class="tt__moon"
      d="M13.2 9.6A5.6 5.6 0 0 1 6.4 2.8a5.6 5.6 0 1 0 6.8 6.8Z"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linejoin="round"
    />
  </svg>
</button>

<style>
  .tt {
    display: inline-grid;
    place-items: center;
    width: 36px;
    height: 36px;
    padding: 0;
    background: transparent;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    color: var(--ink-muted);
    cursor: pointer;
    transition: color var(--dur) var(--ease), border-color var(--dur) var(--ease);
  }

  .tt:hover {
    color: var(--accent-2);
    border-color: color-mix(in srgb, var(--accent-2-graphic) 45%, var(--line));
  }

  .tt svg {
    overflow: visible;
  }

  /* Light theme shows the moon (what you'd switch to); dark shows the sun. */
  .tt__moon {
    opacity: 1;
    transition: opacity var(--dur) var(--ease);
  }

  .tt__sun,
  .tt__rays {
    opacity: 0;
    transition: opacity var(--dur) var(--ease);
  }

  :global(:root[data-theme='dark']) .tt__moon {
    opacity: 0;
  }

  :global(:root[data-theme='dark']) .tt__sun,
  :global(:root[data-theme='dark']) .tt__rays {
    opacity: 1;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .tt__moon {
      opacity: 0;
    }
    :global(:root:not([data-theme='light'])) .tt__sun,
    :global(:root:not([data-theme='light'])) .tt__rays {
      opacity: 1;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('.tt').forEach((el) => {
    el.addEventListener('click', () => {
      const root = document.documentElement;
      const systemDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      const current = root.dataset.theme ?? (systemDark ? 'dark' : 'light');
      const next = current === 'dark' ? 'light' : 'dark';
      root.dataset.theme = next;
      try {
        localStorage.setItem('cf-theme', next);
      } catch {
        /* private mode: the choice just won't persist */
      }
    });
  });
</script>
