---
import Button from './Button.astro';
import { LINKS } from '../config/links';

interface Props {
  heading?: string;
  body?: string;
}

const {
  heading = "Moving money into or out of Africa? Let's talk.",
  body,
} = Astro.props;
---

<section class="cta">
  <div class="wrap cta__inner" data-reveal>
    <div class="cta__text">
      <h2 class="cta__head">{heading}</h2>
      {body && <p class="cta__body">{body}</p>}
    </div>
    <Button href={LINKS.contact.href} external>Talk to us</Button>
  </div>
</section>

<style>
  .cta {
    border-top: 1px solid var(--line);
    background: var(--surface-2);
    position: relative;
    overflow: hidden;
  }

  /* A single amber hairline across the top: the technical seam. */
  .cta::before {
    content: '';
    position: absolute;
    top: -1px;
    left: 0;
    width: 180px;
    height: 2px;
    background: var(--accent-2-graphic);
  }

  .cta__inner {
    padding-block: 64px;
    display: grid;
    gap: 24px;
    align-items: center;
  }

  .cta__head {
    font-size: 28px;
    line-height: 36px;
    max-width: 30ch;
  }

  .cta__body {
    margin-top: 10px;
    color: var(--ink-muted);
    max-width: 58ch;
  }

  @media (min-width: 860px) {
    .cta__inner {
      grid-template-columns: 1fr auto;
      gap: 40px;
      padding-block: 80px;
    }

    .cta__head {
      font-size: 36px;
      line-height: 44px;
    }
  }
</style>
