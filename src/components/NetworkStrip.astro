---
/**
 * The horizontal flow of supported networks, in full colour, running edge to
 * edge under the hero. The track is duplicated and translated by exactly -50%
 * so the loop is seamless; it pauses on hover and stops dead under
 * prefers-reduced-motion, where it simply reads as a static row.
 */
import NetworkLogo from './NetworkLogo.astro';
import { NETWORKS, NETWORK_ORDER, STATUS } from '../config/links';

interface Props {
  /** Seconds for one full pass. */
  speed?: number;
}

const { speed = 38 } = Astro.props;

const items = NETWORK_ORDER.map((id) => ({
  id,
  name: NETWORKS[id].name,
  role: NETWORKS[id].role,
  /* Base and Solana are reached through the Tempo deployment, so a bare
     "Live" would overstate them; their role is the honest label. */
  status: NETWORKS[id].statusNote ? NETWORKS[id].role : STATUS[NETWORKS[id].status].label,
  tone: NETWORKS[id].status,
}));

/*
 * The loop translates the track by exactly -50%, so the two halves must be
 * identical AND one half must be at least as wide as the viewport -- with
 * only four networks, a single pass is far narrower than a wide screen and
 * the tail of the loop shows as a gap. Repeating the list enough times per
 * half keeps the row continuous at any width.
 */
const COPIES_PER_HALF = 4;
const half = Array.from({ length: COPIES_PER_HALF }, () => items).flat();
const track = [...half, ...half];
---

<section class="ns" aria-label="Supported settlement and routing networks">
  <div class="ns__track" style={`--ns-speed:${speed}s`}>
    {
      track.map((n, i) => (
        <div class="ns__item" aria-hidden={i >= items.length ? 'true' : undefined}>
          <NetworkLogo network={n.id} size={30} />
          <span class="ns__meta">
            <span class="ns__name">{n.name}</span>
            <span class:list={['ns__status', `is-${n.tone}`]}>{n.status}</span>
          </span>
        </div>
      ))
    }
  </div>
</section>

<style>
  .ns {
    position: relative;
    overflow: hidden;
    border-block: 1px solid var(--line);
    background: var(--surface-3);
    /* Fade the ends so logos enter and leave rather than being chopped. */
    mask-image: linear-gradient(90deg, transparent, #000 7%, #000 93%, transparent);
  }

  .ns__track {
    display: flex;
    width: max-content;
    /* Promoted to its own layer so the transform runs on the compositor and
       does not judder against the page's grain overlay. */
    will-change: transform;
    animation: marquee-l var(--ns-speed) linear infinite;
  }

  .ns:hover .ns__track {
    animation-play-state: paused;
  }

  .ns__item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 18px 34px;
    border-right: 1px solid var(--line);
    flex: none;
  }

  .ns__meta {
    display: grid;
    gap: 2px;
  }

  .ns__name {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }

  .ns__status {
    font-size: 9.5px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-muted);
    white-space: nowrap;
  }

  .ns__status.is-live-mainnet {
    color: var(--y-700);
  }

  .ns__status.is-testnet {
    color: var(--ink-muted);
  }

  @media (prefers-reduced-motion: reduce) {
    .ns__track {
      animation: none;
    }
  }
</style>
