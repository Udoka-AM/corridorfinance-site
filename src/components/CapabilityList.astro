---
interface Props {
  items: readonly { title: string; body?: string }[];
}
const { items } = Astro.props;
---

<ul class="cl">
  {
    items.map((it, i) => (
      <li class="cl__item" data-reveal data-reveal-delay={i * 60}>
        <span class="cl__num">{String(i + 1).padStart(2, '0')}</span>
        <h3 class="cl__title">{it.title}</h3>
        {it.body && <p class="cl__body">{it.body}</p>}
      </li>
    ))
  }
</ul>

<style>
  .cl {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    border-top: 1px solid var(--line);
  }

  .cl__item {
    display: grid;
    gap: 8px;
    padding: 28px 0;
    border-bottom: 1px solid var(--line);
    position: relative;
  }

  .cl__item::before {
    content: '';
    position: absolute;
    top: -1px;
    left: 0;
    width: 26px;
    height: 2px;
    background: var(--y-300);
  }

  .cl__num {
    font-size: 10.5px;
    letter-spacing: 0.12em;
    color: var(--accent-text);
  }

  .cl__body {
    font-size: 13.5px;
    line-height: 24px;
    color: var(--ink-2);
    max-width: 52ch;
  }

  @media (min-width: 820px) {
    .cl {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 48px;
    }
  }
</style>
