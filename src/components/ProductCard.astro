---
interface Props {
  name: string;
  audience: string;
  body: string;
  href: string;
  icon?: 'core' | 'hub' | 'ramp';
  index?: number;
  delay?: number;
}

const { name, audience, body, href, icon = 'core', index, delay = 0 } = Astro.props;
---

<a href={href} class="card card--link pc" data-reveal data-reveal-delay={delay}>
  <div class="pc__top">
    <span class="icon-box">
      <svg width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true">
        {
          icon === 'core' && (
            <>
              <rect x="2.75" y="7.25" width="14.5" height="5.5" stroke="currentColor" stroke-width="1.5" />
              <path d="M2.75 4.5h14.5M2.75 15.5h14.5" stroke="currentColor" stroke-width="1.5" />
            </>
          )
        }
        {
          icon === 'hub' && (
            <>
              <circle cx="10" cy="10" r="2.6" stroke="currentColor" stroke-width="1.5" />
              <path d="M10 2.75v4.65M10 12.6v4.65M2.75 10h4.65M12.6 10h4.65" stroke="currentColor" stroke-width="1.5" />
            </>
          )
        }
        {
          icon === 'ramp' && (
            <>
              <path d="M2.75 15.25 17.25 4.75" stroke="currentColor" stroke-width="1.5" />
              <path d="M11.5 4.75h5.75v5.75" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
            </>
          )
        }
      </svg>
    </span>
    {index && <span class="num">{String(index).padStart(2, '0')}</span>}
  </div>

  <h3 class="pc__name">{name}</h3>
  <p class="pc__audience">{audience}</p>
  <p class="pc__body">{body}</p>
  <span class="pc__more">Learn more <span aria-hidden="true">→</span></span>
</a>

<style>
  .pc {
    display: grid;
    align-content: start;
    gap: 7px;
    height: 100%;
    padding: 30px 26px 26px;
  }

  .pc__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 16px;
  }

  .pc__audience {
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent-text);
  }

  .pc__body {
    margin-top: 8px;
    font-size: 13.5px;
    line-height: 24px;
    color: var(--ink-2);
  }

  .pc__more {
    margin-top: 18px;
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
</style>
