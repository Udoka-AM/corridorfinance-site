---
import StatusBadge from './StatusBadge.astro';
import type { StatusId } from '../config/links';

interface Props {
  name: string;
  audience: string;
  body: string;
  href: string;
  status?: StatusId;
  /** Lucide-style glyph key. */
  icon?: 'core' | 'hub' | 'ramp';
  delay?: number;
}

const { name, audience, body, href, status, icon = 'core', delay = 0 } = Astro.props;
---

<a href={href} class="card card--link pc" data-reveal data-reveal-delay={delay}>
  <div class="pc__top">
    <svg class="pc__icon" width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
      {
        icon === 'core' && (
          <>
            <rect x="2.75" y="7.25" width="14.5" height="5.5" rx="1.5" stroke="currentColor" stroke-width="1.5" />
            <path d="M2.75 4.5h14.5M2.75 15.5h14.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
          </>
        )
      }
      {
        icon === 'hub' && (
          <>
            <circle cx="10" cy="10" r="2.5" stroke="currentColor" stroke-width="1.5" />
            <path d="M10 2.75v4.75M10 12.5v4.75M2.75 10h4.75M12.5 10h4.75" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
          </>
        )
      }
      {
        icon === 'ramp' && (
          <>
            <path d="M2.75 15.25 17.25 4.75" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
            <path d="M11.5 4.75h5.75v5.75" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          </>
        )
      }
    </svg>
    {status && <StatusBadge status={status} />}
  </div>

  <h3 class="pc__name">{name}</h3>
  <p class="pc__audience">{audience}</p>
  <p class="pc__body">{body}</p>

  <span class="pc__more">
    Learn more
    <svg class="card__arrow" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
      <path d="M3 7h8M7.5 3.5 11 7l-3.5 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </span>
</a>

<style>
  .pc {
    display: grid;
    align-content: start;
    gap: 8px;
    text-decoration: none;
    height: 100%;
  }

  .pc__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 10px;
  }

  .pc__icon {
    color: var(--accent);
  }

  .pc__name {
    color: var(--ink);
  }

  .pc__audience {
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent-2);
  }

  .pc__body {
    color: var(--ink-muted);
    font-size: 16px;
    line-height: 26px;
    margin-top: 4px;
  }

  .pc__more {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 14px;
    font-size: 14px;
    font-weight: 500;
    color: var(--accent);
  }
</style>
