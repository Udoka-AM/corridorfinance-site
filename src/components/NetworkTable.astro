---
import StatusBadge from './StatusBadge.astro';
import NetworkLogo from './NetworkLogo.astro';
import { LINKS, NETWORKS, NETWORK_ORDER, NETWORK_NOTE } from '../config/links';
---

<div class="nt" data-reveal>
  <table class="nt__table">
    <caption class="nt__caption">Settlement and routing networks, with current status.</caption>
    <thead>
      <tr>
        <th scope="col">Network</th>
        <th scope="col">Role</th>
        <th scope="col">Status</th>
        <th scope="col">Links</th>
      </tr>
    </thead>
    <tbody>
      {
        NETWORK_ORDER.map((id) => {
          const n = NETWORKS[id];
          return (
            <tr>
              <th scope="row" class="nt__name">
                <NetworkLogo network={id} size={22} />
                {n.name}
              </th>
              <td class="nt__role">{n.roleLong}</td>
              <td>
                <StatusBadge status={n.status} note={n.statusNote} />
              </td>
              <td>
                {n.links.length > 0 ? (
                  <span class="nt__links">
                    {n.links.map((lid) => {
                      const l = LINKS[lid];
                      const short = l.label.split(': ').at(-1) ?? l.label;
                      return (
                        <a href={l.href} target="_blank" rel="noopener noreferrer" class="nt__link">
                          {short} <span aria-hidden="true">↗</span>
                        </a>
                      );
                    })}
                  </span>
                ) : (
                  <span class="nt__dash">&mdash;</span>
                )}
              </td>
            </tr>
          );
        })
      }
    </tbody>
  </table>
</div>

<p class="nt__note">{NETWORK_NOTE}</p>

<style>
  .nt {
    border: 1px solid var(--line);
    overflow-x: auto;
    background: var(--surface-3);
  }

  .nt__table {
    width: 100%;
    min-width: 660px;
    border-collapse: collapse;
    font-size: 13px;
  }

  .nt__caption {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }

  .nt__table th,
  .nt__table td {
    text-align: left;
    padding: 16px 20px;
    vertical-align: middle;
  }

  .nt__table thead th {
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-muted);
    background: var(--surface-2);
    border-bottom: 1px solid var(--line);
    padding-block: 12px;
  }

  .nt__table tbody tr + tr th,
  .nt__table tbody tr + tr td {
    border-top: 1px solid var(--line);
  }

  .nt__table tbody tr:hover {
    background: var(--y-50);
  }

  .nt__name {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 14px;
    font-weight: 700;
    white-space: nowrap;
  }

  .nt__role {
    color: var(--ink-muted);
  }

  .nt__links {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 14px;
  }

  .nt__link {
    font-size: 12px;
    color: var(--ink-2);
    border-bottom: 1px solid var(--y-400);
    white-space: nowrap;
  }

  .nt__link:hover {
    color: var(--ink);
  }

  .nt__dash {
    color: var(--ink-muted);
  }

  .nt__note {
    margin-top: 14px;
    font-size: 11.5px;
    color: var(--ink-muted);
  }
</style>
