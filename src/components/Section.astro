---
interface Props {
  /** Accrium-style bracketed eyebrow; pass the number separately. */
  eyebrow?: string;
  num?: string;
  heading?: string;
  tag?: string;
  band?: boolean;
  white?: boolean;
  tight?: boolean;
  id?: string;
  class?: string;
}

const {
  eyebrow,
  num,
  heading,
  tag,
  band = false,
  white = false,
  tight = false,
  id,
  class: cls = '',
} = Astro.props;

const label = num && eyebrow ? `${num} / ${eyebrow}` : (eyebrow ?? '');
---

<section
  id={id}
  class:list={['section', 'rule-top', { band, 'band-white': white, 'section--tight': tight }, cls]}
>
  <div class="bleed">
    {
      (label || heading) && (
        <header class="sec__head" data-reveal>
          {label && <p class="eyebrow">{label}</p>}
          {tag && <span class="tag">{tag}</span>}
          {heading && <h2 class="sec__h2">{heading}</h2>}
          <slot name="lede" />
        </header>
      )
    }
    <slot />
  </div>
</section>

<style>
  .sec__head {
    display: grid;
    justify-items: start;
    gap: 16px;
    margin-bottom: 44px;
  }

  .sec__h2 {
    max-width: 18ch;
  }
</style>
