---
interface Props {
  /** Small mono label above the heading. */
  eyebrow?: string;
  heading?: string;
  /** Renders as a band with surface-2 and hairline borders. */
  band?: boolean;
  tight?: boolean;
  id?: string;
  class?: string;
}

const { eyebrow, heading, band = false, tight = false, id, class: cls = '' } = Astro.props;
---

<section
  id={id}
  class:list={['section', { band, 'section--tight': tight }, cls]}
>
  <div class="wrap">
    {
      (eyebrow || heading) && (
        <header class="sec__head" data-reveal>
          {eyebrow && <p class="eyebrow tick-rule">{eyebrow}</p>}
          {heading && <h2>{heading}</h2>}
          <slot name="lede" />
        </header>
      )
    }
    <slot />
  </div>
</section>

<style>
  .sec__head {
    display: grid;
    gap: 14px;
    margin-bottom: 40px;
    max-width: 72ch;
  }

  .sec__head .eyebrow {
    gap: 10px;
  }
</style>
