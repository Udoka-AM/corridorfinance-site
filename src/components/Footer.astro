---
import Wordmark from './Wordmark.astro';
import { LINKS } from '../config/links';

const year = 2026;

const columns = [
  {
    head: 'Products',
    items: [
      { label: 'Corridor Hub', href: '/products/hub' },
      { label: 'Corridor Ramp', href: '/products/ramp' },
      { label: 'Platform', href: '/platform' },
    ],
  },
  {
    head: 'Networks',
    items: [
      { label: 'Settlement networks', href: '/networks' },
      { label: 'Tempo console', href: LINKS.tempoConsole.href, external: true },
    ],
  },
  {
    head: 'Developers',
    items: [
      { label: 'Overview', href: '/developers' },
      { label: 'Docs', href: LINKS.tempoDocs.href, external: true },
      { label: 'GitHub', href: LINKS.founderGithub.href, external: true },
    ],
  },
  {
    head: 'Company',
    items: [
      { label: 'About', href: '/company' },
      { label: 'Contact', href: LINKS.contact.href, external: true },
    ],
  },
  {
    head: 'Legal',
    items: [
      { label: 'Terms', href: '/legal/terms' },
      { label: 'Privacy', href: '/legal/privacy' },
    ],
  },
];
---

<footer class="ft">
  <div class="wrap">
    <div class="ft__top">
      <div class="ft__brand">
        <Wordmark />
        <p class="ft__tag">
          Payout infrastructure for money moving into and out of Africa. Built in Abuja, Nigeria.
        </p>
      </div>

      <div class="ft__cols">
        {
          columns.map((col) => (
            <div class="ft__col">
              <h2 class="ft__head">{col.head}</h2>
              <ul class="ft__list">
                {col.items.map((item) => (
                  <li>
                    <a
                      href={item.href}
                      class="ft__link"
                      rel={item.external ? 'noopener noreferrer' : undefined}
                      target={item.external ? '_blank' : undefined}
                    >
                      {item.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>

    <div class="ft__legal">
      <p class="ft__legal-text">
        Corridor Finance provides software. It is not a bank, custodian or money transmitter, and
        does not hold customer funds. Fiat payouts are carried out by licensed partners in each
        corridor. Network availability varies by corridor.
      </p>
      <p class="ft__copy">&copy; {year} Corridor Finance</p>

      {/*
        Reserved slot. If a Stellar Community Fund award is received, any
        "built on Stellar" or "SCF award recipient" mention goes here, next to
        SCF's required disclaimer, with no SDF logo. Keep it commented out
        until an award is actually in hand.

        <p class="ft__scf">
          Corridor Finance is a Stellar Community Fund award recipient.
          <span>[SCF required disclaimer text goes here, verbatim.]</span>
        </p>
      */}
    </div>
  </div>
</footer>

<style>
  .ft {
    border-top: 1px solid var(--line);
    background: var(--surface-2);
    padding-block: 56px 32px;
  }

  .ft__top {
    display: grid;
    gap: 40px;
  }

  .ft__brand {
    display: grid;
    gap: 12px;
    align-content: start;
  }

  .ft__tag {
    font-size: 14px;
    line-height: 22px;
    color: var(--ink-muted);
    max-width: 30ch;
  }

  .ft__cols {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 28px 20px;
  }

  .ft__head {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-muted);
    margin-bottom: 12px;
  }

  .ft__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 8px;
  }

  .ft__link {
    font-size: 14px;
    line-height: 22px;
    color: var(--ink);
    text-decoration: none;
    transition: color var(--dur) var(--ease);
  }

  .ft__link:hover {
    color: var(--accent);
  }

  .ft__legal {
    margin-top: 48px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
    display: grid;
    gap: 12px;
  }

  .ft__legal-text {
    font-size: 13px;
    line-height: 21px;
    color: var(--ink-muted);
    max-width: 90ch;
  }

  .ft__copy {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--ink-muted);
  }

  @media (min-width: 700px) {
    .ft__cols {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }

  @media (min-width: 1000px) {
    .ft__top {
      grid-template-columns: 1fr 2.2fr;
      gap: 64px;
    }
  }
</style>
