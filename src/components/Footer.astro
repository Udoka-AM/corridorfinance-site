---
/**
 * Structured after retinaos.xyz: a CTA row at the top, then the brand block
 * with a live status pill beside four link columns, a giant ghosted wordmark
 * across the full width, and a bottom bar carrying the legal line.
 */
import Wordmark from './Wordmark.astro';
import Button from './Button.astro';
import { LINKS } from '../config/links';

const year = 2026;

const columns = [
  {
    head: 'Products',
    items: [
      { label: 'Corridor Hub', href: '/products/hub/' },
      { label: 'Corridor Ramp', href: '/products/ramp/' },
      { label: 'Platform', href: '/platform/' },
    ],
  },
  {
    head: 'Networks',
    items: [
      { label: 'Settlement networks', href: '/networks/' },
      { label: 'Live console', href: LINKS.tempoConsole.href, external: true },
    ],
  },
  {
    head: 'Developers',
    items: [
      { label: 'Overview', href: '/developers/' },
      { label: 'Docs', href: LINKS.tempoDocs.href, external: true },
      { label: 'GitHub', href: LINKS.founderGithub.href, external: true },
    ],
  },
  {
    head: 'Company',
    items: [
      { label: 'About', href: '/company/' },
      { label: 'Contact', href: LINKS.contact.href, external: true },
      { label: 'Terms', href: '/legal/terms/' },
      { label: 'Privacy', href: '/legal/privacy/' },
    ],
  },
];
---

<footer class="ft">
  <!-- CTA row -->
  <div class="ft__cta bleed">
    <div>
      <h2 class="ft__cta-head">Move money into and out of Africa.</h2>
      <p class="ft__cta-sub">One integration, on the network that fits each corridor.</p>
    </div>
    <div class="ft__cta-btns">
      <Button href={LINKS.contact.href} external>Talk to us</Button>
      <Button href={LINKS.tempoDocs.href} external variant="ghost">Read the docs</Button>
    </div>
  </div>

  <!-- brand + columns -->
  <div class="ft__main bleed">
    <div class="ft__brand">
      <Wordmark />
      <p class="ft__tag">
        Payout infrastructure for money moving into and out of Africa. Built in Abuja, Nigeria.
      </p>
      <span class="ft__pill">
        <span class="ft__dot" aria-hidden="true"></span>
        Tempo live on mainnet
      </span>
    </div>

    <div class="ft__cols">
      {
        columns.map((col) => (
          <div>
            <h3 class="ft__head">{col.head}</h3>
            <ul class="ft__list">
              {col.items.map((item) => (
                <li>
                  <a
                    href={item.href}
                    class="ft__link"
                    rel={item.external ? 'noopener noreferrer' : undefined}
                    target={item.external ? '_blank' : undefined}
                  >
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>

  <!-- ghosted wordmark -->
  <div class="ft__ghost" aria-hidden="true">CORRIDOR</div>

  <!-- bottom bar -->
  <div class="ft__bottom bleed">
    <p class="ft__legal">
      Corridor Finance provides software. It is not a bank, custodian or money transmitter, and
      does not hold customer funds. Fiat payouts are carried out by licensed partners in each
      corridor. Network availability varies by corridor.
    </p>
    <p class="ft__copy">&copy; {year} Corridor Finance</p>

    {/*
      Reserved slot. If a Stellar Community Fund award is received, any
      "built on Stellar" or "SCF award recipient" mention goes here, next to
      SCF's required disclaimer, with no SDF logo. Keep it commented out
      until an award is actually in hand.

      <p class="ft__scf">
        Corridor Finance is a Stellar Community Fund award recipient.
        <span>[SCF required disclaimer text goes here, verbatim.]</span>
      </p>
    */}
  </div>
</footer>

<style>
  .ft {
    background: var(--surface-2);
    border-top: 1px solid var(--line);
    overflow: hidden;
  }

  .ft__cta {
    display: grid;
    gap: 22px;
    padding-block: 56px;
    border-bottom: 1px solid var(--line);
  }

  .ft__cta-head {
    font-size: clamp(22px, 2.6vw, 34px);
    max-width: 20ch;
  }

  .ft__cta-sub {
    margin-top: 10px;
    font-size: 13px;
    color: var(--ink-muted);
  }

  .ft__cta-btns {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .ft__main {
    display: grid;
    gap: 40px;
    padding-block: 48px;
  }

  .ft__brand {
    display: grid;
    gap: 14px;
    align-content: start;
  }

  .ft__tag {
    font-size: 12.5px;
    line-height: 21px;
    color: var(--ink-muted);
    max-width: 34ch;
  }

  .ft__pill {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    justify-self: start;
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 6px 10px;
    border: 1px solid var(--y-400);
    background: var(--y-50);
    color: var(--y-700);
  }

  .ft__dot {
    width: 5px;
    height: 5px;
    border-radius: 999px;
    background: var(--y-500);
    animation: blink 2.6s steps(2, end) infinite;
  }

  .ft__cols {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 28px 20px;
  }

  .ft__head {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-muted);
    margin-bottom: 14px;
  }

  .ft__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 9px;
  }

  .ft__link {
    font-size: 12.5px;
    color: var(--ink-2);
    transition: color var(--dur) var(--ease);
  }

  .ft__link:hover {
    color: var(--ink);
  }

  /* The wordmark bleeds the full width and is cropped by the footer. */
  .ft__ghost {
    font-size: clamp(76px, 21vw, 300px);
    font-weight: 700;
    letter-spacing: -0.05em;
    line-height: 0.78;
    text-align: center;
    color: transparent;
    -webkit-text-stroke: 1px var(--line-strong);
    padding-top: 10px;
    margin-bottom: -0.14em;
    white-space: nowrap;
    pointer-events: none;
  }

  .ft__bottom {
    display: grid;
    gap: 12px;
    padding-block: 24px 30px;
    border-top: 1px solid var(--line);
  }

  .ft__legal {
    font-size: 11px;
    line-height: 19px;
    color: var(--ink-muted);
    max-width: 92ch;
  }

  .ft__copy {
    font-size: 11px;
    letter-spacing: 0.08em;
    color: var(--ink-muted);
  }

  @media (min-width: 700px) {
    .ft__cols {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media (min-width: 900px) {
    .ft__cta {
      grid-template-columns: 1fr auto;
      align-items: center;
      gap: 48px;
      padding-block: 64px;
    }
    .ft__main {
      grid-template-columns: 1fr 2fr;
      gap: 64px;
      padding-block: 60px;
    }
    .ft__bottom {
      grid-template-columns: 1fr auto;
      align-items: center;
      gap: 32px;
    }
  }
</style>
