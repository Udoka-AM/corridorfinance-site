---
import { STATUS, type StatusId } from '../config/links';

interface Props {
  status: StatusId;
  note?: string;
  class?: string;
}

const { status, note, class: cls = '' } = Astro.props;
const s = STATUS[status];
---

{
  status !== 'none' && (
    <span class={`bdg bdg--${s.variant} ${cls}`}>
      <span class="bdg__dot" aria-hidden="true" />
      {s.label}
      {note && <span class="bdg__note">({note})</span>}
    </span>
  )
}

<style>
  .bdg {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 9.5px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 6px 9px;
    border: 1px solid transparent;
    white-space: nowrap;
  }

  .bdg__dot {
    width: 5px;
    height: 5px;
    background: currentColor;
    flex: none;
  }

  .bdg__note {
    font-weight: 400;
    opacity: 0.7;
  }

  /* Live: the only status that gets the solid yellow. */
  .bdg--solid {
    background: var(--y-300);
    border-color: var(--y-400);
    color: var(--ink);
  }

  .bdg--solid .bdg__dot {
    animation: blink 2.4s steps(2, end) infinite;
  }

  .bdg--outline {
    background: transparent;
    border-color: var(--line-strong);
    color: var(--ink-muted);
  }

  .bdg--outline .bdg__dot {
    background: var(--y-500);
  }

  .bdg--muted {
    background: transparent;
    color: var(--ink-muted);
    padding-inline: 0;
  }

  .bdg--muted .bdg__dot {
    background: var(--line-strong);
  }
</style>
