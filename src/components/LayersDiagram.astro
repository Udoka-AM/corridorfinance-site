---
/**
 * The layers diagram: products on top, Core in the middle, settlement networks
 * at the base, licensed partners below the frame. Drawn with tokens so it
 * themes, and with an amber dashed flow that marches downward through the
 * layers. Labels only, no package names.
 *
 * Two SVGs, one wide and one tall, swapped by CSS so the stack reflows on
 * mobile. Both are aria-hidden: the same information is in the page copy, and
 * a single visually-hidden summary stands in for the graphic.
 */
interface Props {
  /** `lg` is the standalone diagram on /platform; `md` rides beside the hero. */
  size?: 'md' | 'lg';
  class?: string;
}

const { size = 'md', class: cls = '' } = Astro.props;

const L = {
  hub: { name: 'Corridor Hub', sub: 'payment companies' },
  ramp: { name: 'Corridor Ramp', sub: 'apps · agents' },
  core: { name: 'Corridor Core', sub: 'exactly-once settlement, ledger, reconciliation' },
  nets: [
    { name: 'Tempo', status: 'Live · Mainnet', tone: 'live' },
    { name: 'Stellar', status: 'Testnet', tone: 'test' },
    { name: 'Base · Solana', status: 'routing', tone: 'idle' },
  ],
  foot: 'licensed partners → local bank accounts',
};

const summary =
  'Corridor Hub, for payment companies, and Corridor Ramp, for apps and agents, both sit on ' +
  'Corridor Core, which handles exactly-once settlement, the ledger and reconciliation. Core ' +
  'settles on Tempo, live on mainnet, and Stellar, on testnet, with Base and Solana as routing ' +
  'networks. Below that, licensed partners pay out to local bank accounts.';
---

<figure class={`dg dg--${size} ${cls}`}>
  <!-- wide -->
  <svg class="dg__svg dg__svg--wide" viewBox="0 0 920 440" aria-hidden="true" role="presentation">
    <rect class="dg__frame" x="1" y="1" width="918" height="390" rx="12" />

    <g class="dg__box">
      <rect x="28" y="28" width="420" height="104" rx="8" />
      <text class="dg__name" x="52" y="68">{L.hub.name}</text>
      <text class="dg__sub" x="52" y="94">{L.hub.sub}</text>
    </g>
    <g class="dg__box">
      <rect x="472" y="28" width="420" height="104" rx="8" />
      <text class="dg__name" x="496" y="68">{L.ramp.name}</text>
      <text class="dg__sub" x="496" y="94">{L.ramp.sub}</text>
    </g>

    <line class="dg__div" x1="1" y1="160" x2="919" y2="160" />

    <g class="dg__flow">
      <path d="M238 132 V184" />
      <path d="M682 132 V184" />
    </g>

    <g class="dg__box dg__box--core">
      <rect x="28" y="184" width="864" height="88" rx="8" />
      <text class="dg__name" x="52" y="224">{L.core.name}</text>
      <text class="dg__sub" x="52" y="250">{L.core.sub}</text>
    </g>

    <line class="dg__div" x1="1" y1="296" x2="919" y2="296" />

    <g class="dg__flow"><path d="M460 272 V318" /></g>

    {
      L.nets.map((n, i) => (
        <g class={`dg__chip dg__chip--${n.tone}`}>
          <rect x={28 + i * 296} y="318" width="272" height="54" rx="8" />
          <text class="dg__chip-name" x={48 + i * 296} y="341">
            {n.name}
          </text>
          <circle class="dg__dot" cx={51 + i * 296} cy="356" r="3" />
          <text class="dg__chip-status" x={60 + i * 296} y="360">
            {n.status}
          </text>
        </g>
      ))
    }

    <g class="dg__flow dg__flow--out"><path d="M460 372 V404" /></g>
    <path class="dg__arrow" d="M454 398 460 406 466 398" />
    <text class="dg__foot" x="460" y="428">{L.foot}</text>
  </svg>

  <!-- tall -->
  <svg class="dg__svg dg__svg--tall" viewBox="0 0 360 572" aria-hidden="true" role="presentation">
    <rect class="dg__frame" x="1" y="1" width="358" height="462" rx="12" />

    <g class="dg__box">
      <rect x="20" y="20" width="320" height="76" rx="8" />
      <text class="dg__name" x="40" y="52">{L.hub.name}</text>
      <text class="dg__sub" x="40" y="76">{L.hub.sub}</text>
    </g>
    <g class="dg__box">
      <rect x="20" y="106" width="320" height="76" rx="8" />
      <text class="dg__name" x="40" y="138">{L.ramp.name}</text>
      <text class="dg__sub" x="40" y="162">{L.ramp.sub}</text>
    </g>

    <line class="dg__div" x1="1" y1="206" x2="359" y2="206" />
    <g class="dg__flow"><path d="M180 182 V230" /></g>

    <g class="dg__box dg__box--core">
      <rect x="20" y="230" width="320" height="96" rx="8" />
      <text class="dg__name" x="40" y="262">{L.core.name}</text>
      <text class="dg__sub dg__sub--wrap" x="40" y="286">exactly-once settlement,</text>
      <text class="dg__sub dg__sub--wrap" x="40" y="306">ledger, reconciliation</text>
    </g>

    <line class="dg__div" x1="1" y1="350" x2="359" y2="350" />
    <g class="dg__flow"><path d="M180 326 V372" /></g>

    {
      L.nets.map((n, i) => (
        <g class={`dg__chip dg__chip--${n.tone}`}>
          <rect x="20" y={372 + i * 32} width="320" height="26" rx="6" />
          <text class="dg__chip-name" x="36" y={389 + i * 32}>
            {n.name}
          </text>
          <circle class="dg__dot" cx="243" cy={385 + i * 32} r="3" />
          <text class="dg__chip-status" x="252" y={389 + i * 32}>
            {n.status}
          </text>
        </g>
      ))
    }

    <g class="dg__flow dg__flow--out"><path d="M180 464 V500" /></g>
    <path class="dg__arrow" d="M174 494 180 502 186 494" />
    <text class="dg__foot dg__foot--tall" x="180" y="524">licensed partners</text>
    <text class="dg__foot dg__foot--tall" x="180" y="544">→ local bank accounts</text>
  </svg>

  <figcaption class="dg__sr">{summary}</figcaption>
</figure>

<style>
  .dg {
    margin: 0;
  }

  .dg__svg {
    width: 100%;
    height: auto;
    display: block;
    overflow: visible;
  }

  .dg__svg--tall {
    display: none;
    max-width: 360px;
    margin-inline: auto;
  }

  /* The frame and the dividers are the same hairline as the cards. */
  .dg__frame {
    fill: var(--surface-2);
    stroke: var(--line);
    stroke-width: 1;
  }

  .dg__div {
    stroke: var(--line);
    stroke-width: 1;
  }

  .dg__box rect {
    fill: var(--surface);
    stroke: var(--line);
    stroke-width: 1;
  }

  /* Core carries the green: it is the thing that actually settles. */
  .dg__box--core rect {
    stroke: color-mix(in srgb, var(--accent) 55%, var(--line));
  }

  .dg__name {
    fill: var(--ink);
    font-family: var(--font-sans);
    font-size: 16px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .dg__sub {
    fill: var(--ink-muted);
    font-family: var(--font-sans);
    font-size: 13px;
  }

  .dg__chip rect {
    fill: var(--surface);
    stroke: var(--line);
    stroke-width: 1;
  }

  .dg__chip--live rect {
    fill: var(--accent-wash);
    stroke: color-mix(in srgb, var(--accent) 40%, var(--line));
  }

  .dg__chip--test rect {
    fill: var(--accent-2-wash);
    stroke: color-mix(in srgb, var(--accent-2-graphic) 40%, var(--line));
  }

  .dg__chip-name {
    fill: var(--ink);
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 600;
  }

  .dg__chip-status {
    fill: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.02em;
  }

  .dg__dot {
    fill: var(--line);
  }

  .dg__chip--live .dg__dot {
    fill: var(--accent);
  }

  .dg__chip--test .dg__dot {
    fill: var(--accent-2-graphic);
  }

  /* The flow: amber dashes marching from the products down to the partners. */
  .dg__flow path {
    fill: none;
    stroke: var(--accent-2-graphic);
    stroke-width: 1.5;
    stroke-dasharray: 5 6;
    animation: march 1.1s linear infinite;
  }

  .dg__flow--out path {
    stroke-dasharray: 4 5;
  }

  @keyframes march {
    to {
      stroke-dashoffset: -11;
    }
  }

  .dg__arrow {
    fill: none;
    stroke: var(--accent-2-graphic);
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .dg__foot {
    fill: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: 0.02em;
    text-anchor: middle;
  }

  .dg__sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  @media (max-width: 719px) {
    .dg__svg--wide {
      display: none;
    }
    .dg__svg--tall {
      display: block;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .dg__flow path {
      animation: none;
      stroke-dasharray: 5 6;
    }
  }
</style>
