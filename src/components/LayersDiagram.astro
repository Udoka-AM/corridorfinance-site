---
/**
 * The layers diagram: products on top, Core in the middle, settlement networks
 * at the base, licensed partners below the frame. Labels only, no package
 * names.
 *
 * Two SVGs, one wide and one tall, swapped by CSS so the stack reflows on
 * mobile. Both are aria-hidden -- the same information is in the page copy --
 * with a single visually-hidden summary standing in for the graphic.
 */
import NetworkLogo from './NetworkLogo.astro';

interface Props {
  size?: 'md' | 'lg';
  class?: string;
}

const { size = 'md', class: cls = '' } = Astro.props;

const summary =
  'Corridor Hub, for payment companies, and Corridor Ramp, for apps and agents, both sit on ' +
  'Corridor Core, which handles exactly-once settlement, the ledger and reconciliation. Core ' +
  'settles on Tempo, live on mainnet, and Stellar, on testnet, with Base and Solana as routing ' +
  'networks. Below that, licensed partners pay out to local bank accounts.';

/* Chip treatment carries the status: live is filled, testnet is outlined with
   a yellow rule, routing is plain. They must not look alike. */
const chips = [
  { id: 'tempo' as const, name: 'Tempo', status: 'Live · Mainnet', tone: 'live' },
  { id: 'stellar' as const, name: 'Stellar', status: 'Testnet', tone: 'test' },
  { id: 'base' as const, name: 'Base · Solana', status: 'Routing', tone: 'idle' },
];
---

<figure class={`art dg dg--${size} ${cls}`}>
  <!-- wide -->
  <svg class="art__svg dg__wide" viewBox="0 0 920 452" aria-hidden="true">
    <rect class="art__frame" x="0.5" y="0.5" width="919" height="392" />

    <g>
      <rect class="art__box" x="24" y="24" width="428" height="96" />
      <text class="art__t" x="48" y="62">Corridor Hub</text>
      <text class="art__s" x="48" y="86">payment companies</text>
      <rect class="art__mark" x="24" y="24" width="30" height="2" />
    </g>
    <g>
      <rect class="art__box" x="468" y="24" width="428" height="96" />
      <text class="art__t" x="492" y="62">Corridor Ramp</text>
      <text class="art__s" x="492" y="86">apps · agents</text>
      <rect class="art__mark" x="468" y="24" width="30" height="2" />
    </g>

    <line class="art__div" x1="0.5" y1="148" x2="919.5" y2="148" />
    <path class="art__flow" d="M238 120 V172" />
    <path class="art__flow" d="M682 120 V172" />

    <g>
      <rect class="art__box art__box--key" x="24" y="172" width="872" height="88" />
      <text class="art__t" x="48" y="208">Corridor Core</text>
      <text class="art__s" x="48" y="232">exactly-once settlement, ledger, reconciliation</text>
    </g>

    <line class="art__div" x1="0.5" y1="288" x2="919.5" y2="288" />
    <path class="art__flow" d="M460 260 V312" />

    {
      chips.map((c, i) => {
        const x = 24 + i * 296;
        return (
          <g class={`dg__chip dg__chip--${c.tone}`}>
            <rect class="dg__chip-bg" x={x} y="312" width="272" height="58" />
            <g transform={`translate(${x + 16} 329)`}>
              <foreignObject width="22" height="22">
                <NetworkLogo network={c.id} size={22} />
              </foreignObject>
            </g>
            <text class="art__t dg__chip-name" x={x + 48} y="337">
              {c.name}
            </text>
            <text class="art__k" x={x + 48} y="356">
              {c.status}
            </text>
          </g>
        );
      })
    }

    <path class="art__flow art__flow--slow" d="M460 370 V408" />
    <path class="art__arrow" d="M454 402 460 410 466 402" />
    <text class="art__k art__mid" x="460" y="436">licensed partners → local bank accounts</text>
  </svg>

  <!-- tall -->
  <svg class="art__svg dg__tall" viewBox="0 0 360 600" aria-hidden="true">
    <rect class="art__frame" x="0.5" y="0.5" width="359" height="486" />

    <g>
      <rect class="art__box" x="20" y="20" width="320" height="72" />
      <text class="art__t" x="38" y="50">Corridor Hub</text>
      <text class="art__s" x="38" y="72">payment companies</text>
      <rect class="art__mark" x="20" y="20" width="26" height="2" />
    </g>
    <g>
      <rect class="art__box" x="20" y="104" width="320" height="72" />
      <text class="art__t" x="38" y="134">Corridor Ramp</text>
      <text class="art__s" x="38" y="156">apps · agents</text>
      <rect class="art__mark" x="20" y="104" width="26" height="2" />
    </g>

    <line class="art__div" x1="0.5" y1="200" x2="359.5" y2="200" />
    <path class="art__flow" d="M180 176 V224" />

    <g>
      <rect class="art__box art__box--key" x="20" y="224" width="320" height="92" />
      <text class="art__t" x="38" y="254">Corridor Core</text>
      <text class="art__s" x="38" y="276">exactly-once settlement,</text>
      <text class="art__s" x="38" y="296">ledger, reconciliation</text>
    </g>

    <line class="art__div" x1="0.5" y1="340" x2="359.5" y2="340" />
    <path class="art__flow" d="M180 316 V364" />

    {
      chips.map((c, i) => {
        const y = 364 + i * 38;
        return (
          <g class={`dg__chip dg__chip--${c.tone}`}>
            <rect class="dg__chip-bg" x="20" y={y} width="320" height="32" />
            <g transform={`translate(32 ${y + 8})`}>
              <foreignObject width="16" height="16">
                <NetworkLogo network={c.id} size={16} />
              </foreignObject>
            </g>
            <text class="art__t dg__chip-name" x="58" y={y + 20} style="font-size:12px">
              {c.name}
            </text>
            <text class="art__k art__end" x="328" y={y + 20}>
              {c.status}
            </text>
          </g>
        );
      })
    }

    <path class="art__flow art__flow--slow" d="M180 488 V526" />
    <path class="art__arrow" d="M174 520 180 528 186 520" />
    <text class="art__k art__mid" x="180" y="552">licensed partners</text>
    <text class="art__k art__mid" x="180" y="572">→ local bank accounts</text>
  </svg>

  <figcaption class="art__sr">{summary}</figcaption>
</figure>

<style>
  .dg__tall {
    display: none;
    max-width: 360px;
    margin-inline: auto;
  }

  /* Status is carried by the chip treatment, not only by its label. */
  .dg__chip-bg {
    fill: var(--surface);
    stroke: var(--line-strong);
    stroke-width: 1;
  }

  .dg__chip--live .dg__chip-bg {
    fill: var(--y-300);
    stroke: var(--y-400);
  }

  .dg__chip--test .dg__chip-bg {
    fill: var(--surface-3);
    stroke: var(--y-500);
    stroke-dasharray: 4 3;
  }

  .dg__chip--idle .dg__chip-bg {
    fill: var(--surface-2);
    stroke: var(--line-strong);
  }

  @media (max-width: 760px) {
    .dg__wide {
      display: none;
    }
    .dg__tall {
      display: block;
    }
  }
</style>
