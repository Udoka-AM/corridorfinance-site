---
import StatusBadge from './StatusBadge.astro';
import { LINKS, NETWORKS, type NetworkId } from '../config/links';

interface Props {
  /** One card per network, or a combined card for the routing pair. */
  networks: NetworkId[];
  delay?: number;
}

const { networks, delay = 0 } = Astro.props;

const entries = networks.map((id) => NETWORKS[id]);
const name = entries.map((n) => n.name).join(' / ');
const role = entries[0].role;
const status = entries[0].status;
const note = entries[0].statusNote;
const linkIds = [...new Set(entries.flatMap((n) => n.links))];
---

<div class="nc card" data-reveal data-reveal-delay={delay}>
  <div class="nc__top">
    <h3 class="nc__name">{name}</h3>
    <StatusBadge status={status} note={note} />
  </div>
  <p class="nc__role">{role}</p>

  {
    linkIds.length > 0 ? (
      <ul class="nc__links">
        {linkIds.map((id) => {
          const l = LINKS[id];
          const short = l.label.split(': ').at(-1) ?? l.label;
          return (
            <li>
              <a href={l.href} target="_blank" rel="noopener noreferrer" class="nc__link">
                {short}
                <svg width="11" height="11" viewBox="0 0 11 11" fill="none" aria-hidden="true">
                  <path d="M3.3 7.7 7.7 3.3M4.2 3.3h3.5v3.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </a>
            </li>
          );
        })}
      </ul>
    ) : (
      <p class="nc__none">Reached through the Tempo deployment.</p>
    )
  }
</div>

<style>
  .nc {
    display: grid;
    align-content: start;
    gap: 6px;
    height: 100%;
  }

  .nc__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    flex-wrap: wrap;
  }

  .nc__name {
    font-size: 19px;
    line-height: 28px;
  }

  .nc__role {
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .nc__links {
    list-style: none;
    margin: 14px 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px 14px;
  }

  .nc__link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 14px;
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, var(--accent) 30%, transparent);
    transition: border-color var(--dur) var(--ease);
  }

  .nc__link:hover {
    border-bottom-color: var(--accent);
  }

  .nc__none {
    margin-top: 14px;
    font-size: 14px;
    line-height: 22px;
    color: var(--ink-muted);
  }
</style>
