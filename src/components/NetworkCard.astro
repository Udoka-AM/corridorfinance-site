---
import StatusBadge from './StatusBadge.astro';
import NetworkLogo from './NetworkLogo.astro';
import { LINKS, NETWORKS, type NetworkId } from '../config/links';

interface Props {
  networks: NetworkId[];
  delay?: number;
}

const { networks, delay = 0 } = Astro.props;

const entries = networks.map((id) => NETWORKS[id]);
const name = entries.map((n) => n.name).join(' · ');
const first = entries[0];
const linkIds = [...new Set(entries.flatMap((n) => n.links))];
---

<div class="nc" data-reveal data-reveal-delay={delay}>
  <div class="nc__logos">
    {networks.map((id) => <NetworkLogo network={id} size={30} />)}
  </div>

  <div class="nc__top">
    <h3 class="nc__name">{name}</h3>
    <StatusBadge status={first.status} note={first.statusNote} />
  </div>
  <p class="nc__role">{first.role}</p>

  {
    linkIds.length > 0 ? (
      <ul class="nc__links">
        {linkIds.map((id) => {
          const l = LINKS[id];
          const short = l.label.split(': ').at(-1) ?? l.label;
          return (
            <li>
              <a href={l.href} target="_blank" rel="noopener noreferrer" class="nc__link">
                {short} <span aria-hidden="true">↗</span>
              </a>
            </li>
          );
        })}
      </ul>
    ) : (
      <p class="nc__none">Reached through the Tempo deployment.</p>
    )
  }
</div>

<style>
  .nc {
    display: grid;
    align-content: start;
    gap: 8px;
    padding: 30px 26px;
    height: 100%;
  }

  .nc__logos {
    display: flex;
    gap: 10px;
    margin-bottom: 14px;
  }

  .nc__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    flex-wrap: wrap;
  }

  .nc__role {
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .nc__links {
    list-style: none;
    margin: 16px 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px 16px;
  }

  .nc__link {
    font-size: 12px;
    color: var(--ink-2);
    border-bottom: 1px solid var(--y-400);
    padding-bottom: 1px;
    transition: color var(--dur) var(--ease);
  }

  .nc__link:hover {
    color: var(--ink);
  }

  .nc__none {
    margin-top: 16px;
    font-size: 12.5px;
    color: var(--ink-muted);
  }
</style>
